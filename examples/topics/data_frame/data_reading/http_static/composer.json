{
  "name": "flow-php/examples",
  "description": "Flow PHP - Examples",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.4",
    "flow-php/etl": "1.x-dev",
    "flow-php/etl-adapter-http": "1.x-dev",
    "nyholm/psr7": "^1.8",
    "symfony/http-client": "^6.4 || ^7.4"
  },
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "archive": {
    "exclude": [
      "vendor"
    ]
  }
}
