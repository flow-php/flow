{% extends 'base_wide.html.twig' %}

{%- block title -%}
    Flow PHP - {{ currentTopic|humanize }} - {{ currentExample|humanize }} - Example
{%- endblock -%}

{%- block description -%}
    Code example showing {{ currentExample|humanize|lower }} {{ currentTopic|humanize|lower }}.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
{% set currentPath = app.request.pathInfo %}
<section class="px-4 sm:px-6 lg:px-8 xl:px-12 mt-6 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)_14rem] xl:grid-cols-[18rem_minmax(0,1fr)_16rem] gap-8 lg:gap-10">

        <aside class="order-2">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationLeft', {currentPath: currentPath})) }}
        </aside>

        <article id="documentation-page" class="order-1 lg:order-2 min-w-0">
            <div id="example">
                <span class="eyebrow">
                    <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                    Example · {{ currentTopic|humanize }}
                </span>
                <h1 class="!mt-3 !mb-4">{{ currentExample|humanize }}</h1>

                <div class="flex flex-wrap gap-2 mb-6">
                    <a class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] hover:border-white/20 hover:bg-white/[0.08] px-3 py-1.5 text-sm font-medium text-white/85 transition-colors no-underline"
                       href="https://github.com/flow-php/flow/tree/1.x/examples/topics/{{ currentTopic }}/{{ currentExample }}"
                       target="_blank" rel="noopener">
                        View on GitHub
                        <img src="{{ asset('images/icons/github.svg') }}" alt="" width="14" height="14" class="opacity-70">
                    </a>
                    <a class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] hover:border-white/20 hover:bg-white/[0.08] px-3 py-1.5 text-sm font-medium text-white/85 transition-colors no-underline"
                       href="https://raw.githubusercontent.com/flow-php/flow/refs/heads/1.x/examples/topics/{{ currentTopic }}/{{ currentExample }}/flow_php_example.zip"
                       target="_blank" rel="noopener">
                        Download zip
                    </a>
                </div>

                {% if description %}
                    <h2 id="description">Description</h2>
                    <article id="example-description" class="card overflow-auto"
                            {{ stimulus_controller('all_links_external') }}>
                        {{ description|markdown_to_html }}
                    </article>
                {% endif %}

                {% if documentation %}
                    <h2 id="documentation-section">Documentation</h2>
                    <article class="card overflow-auto">
                        {{ documentation|markdown_to_html }}
                    </article>
                {% endif %}

                {% apply spaceless %}
                <h2 id="code-heading">Code</h2>
                <div id="code" class="relative">
                    <button class="absolute top-3 right-3 inline-flex items-center justify-center h-9 w-9 rounded-md border border-white/10 bg-black/60 hover:bg-black/80 text-white [&.copied]:before:content-['Copied!'] before:absolute before:-translate-x-20"
                            data-clipboard-target="#code-php"
                            aria-label="Copy code"
                            {{ stimulus_controller('clipboard') }}>
                        <img src="{{ asset('images/icons/copy.svg') }}" alt="" width="16" height="16">
                    </button>
                    <pre class="card !p-4 overflow-auto language-php" data-controller="syntax-highlight"><code id="code-php">{{- code | escape('html') -}}</code></pre>
                </div>
                {% endapply %}
            </div>

            <div class="mt-12">
                <script src="https://giscus.app/client.js"
                        data-repo="flow-php/flow-php.com"
                        data-repo-id="R_kgDOHja2Yg"
                        data-category="Examples"
                        data-category-id="DIC_kwDOHja2Ys4CieC7"
                        data-mapping="url"
                        data-strict="0"
                        data-reactions-enabled="0"
                        data-emit-metadata="0"
                        data-input-position="bottom"
                        data-theme="dark"
                        data-lang="en"
                        crossorigin="anonymous"
                        async>
                </script>
            </div>
        </article>

        <aside class="order-3">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight', {currentPath: currentPath})) }}
        </aside>
    </div>
</section>
{% endblock %}
