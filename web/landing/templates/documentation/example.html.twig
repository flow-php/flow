{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - {{ currentTopic|humanize }} - {{ currentExample|humanize }} - Example
{%- endblock -%}

{%- block description -%}
    Code example showing {{ currentExample|humanize|lower }} {{ currentTopic|humanize|lower }}.
{%- endblock -%}

{%- block hero -%}
{% endblock %}

{% block main %}
<section id="documentation-page" class="mt-5 mb-5 sm:px-4 mx-auto max-w-screen-2xl">
    <div class="grid grid-cols-1 lg:grid-cols-6">
        <div class="order-1 lg:order-0 lg:col-span-1 lg:sticky lg:top-0 lg:max-h-screen lg:overflow-y-auto">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationLeft')) }}
        </div>
        <div class="order-3 lg:order-1 lg:col-span-4 py-2 px-4">
            <div id="example">
                <hr class="lg:hidden"/>
                <h1>Example: {{ currentExample|humanize }}</h1>
                <h3>Topic: {{ currentTopic|humanize }}</h3>
                <div class="mb-5 text-left">
                    <a class="btn btn-primary mr-2" href="https://github.com/flow-php/flow/tree/1.x/examples/topics/{{ currentTopic }}/{{ currentExample }}" target="_blank">
                        View
                        <img src="{{ asset('images/icons/github.svg') }}" alt="external resource" width="16" height="16" class="ml-1">
                    </a>
                    <a href="https://raw.githubusercontent.com/flow-php/flow/refs/heads/1.x/examples/topics/{{ currentTopic }}/{{ currentExample }}/flow_php_example.zip" target="_blank" class="btn btn-primary mb-5">
                        Download
                    </a>
                </div>

                <hr class="hidden lg:block"/>
                {% if description %}
                    <h2 class="text-xl mt-5 mb-5" id="description">Description</h2>
                    <article id="example-description"
                             class="rounded px-4 pt-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 relative mb-10"
                            {{ stimulus_controller('all_links_external') }}
                    >
                        {{ description|markdown_to_html }}
                    </article>
                {% endif %}

                {% if documentation %}
                    <h2 class="text-xl mt-5 mb-5" id="documentation">Documentation</h2>
                    <article class="rounded px-4 pt-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 relative mb-10">
                        {{ documentation|markdown_to_html }}
                    </article>
                {% endif %}

                <hr class="hidden lg:block"/>
                {% apply spaceless %}
                    <h2 class="text-xl mt-5 mb-5" id="documentation">Code</h2>
                    <div id="code" class="relative">
                        <button class="absolute top-[12px] right-[12px] bg-orange-100 rounded px-4 leading-9 [&.copied]:before:content-['Copied!'] before:absolute before:-translate-x-20" data-clipboard-target="#code-php" {{ stimulus_controller('clipboard') }}>
                            <img src="{{ asset('images/icons/copy.svg') }}" alt="copy code-php" width="20" height="20" class="inline">
                        </button>
                        <pre class="rounded p-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 language-php" data-controller="syntax-highlight">
                            <code id="code-php">
                                {{- code | escape('html') -}}
                            </code>
                        </pre>
                    </div>
                {% endapply %}
            </div>

            <div class="mt-5">
                <script src="https://giscus.app/client.js"
                        data-repo="flow-php/flow-php.com"
                        data-repo-id="R_kgDOHja2Yg"
                        data-category="Examples"
                        data-category-id="DIC_kwDOHja2Ys4CieC7"
                        data-mapping="url"
                        data-strict="0"
                        data-reactions-enabled="0"
                        data-emit-metadata="0"
                        data-input-position="bottom"
                        data-theme="dark"
                        data-lang="en"
                        crossorigin="anonymous"
                        async>
                </script>
            </div>

        </div>
        <div class="order-2 lg:order-2 lg:col-span-1 lg:sticky lg:top-0 lg:max-h-screen lg:overflow-y-auto">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight')) }}
        </div>
    </div>
</section>
{% endblock %}