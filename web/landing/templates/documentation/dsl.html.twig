{% extends 'base_wide.html.twig' %}

{%- block title -%}
    DSL - Documentation - Flow PHP - Data Processing Framework
{%- endblock -%}

{%- block description -%}
    DSL Documentation - DSL stands for Domain Specific Language. In the case of Flow, the DSL is used to define simple functions that can be used to transform data.
    Most of those functions are initializing a new instance of a class under the hood since Flow is fully object-oriented.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
{% set currentPath = app.request.pathInfo %}

{% include 'partials/docs_mobile_nav_panel.html.twig' with {currentPath: currentPath} %}

<section class="px-4 sm:px-6 lg:px-8 xl:px-12 mt-6 mb-12" data-hx-boost="true">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)_14rem] xl:grid-cols-[18rem_minmax(0,1fr)_16rem] gap-8 lg:gap-10">

        <aside class="hidden lg:block lg:order-1">
            <nav aria-label="DSL modules">
                <h2 class="px-2.5 mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
                    DSL References
                </h2>

                <a href="{{ path('documentation') }}"
                   class="inline-flex items-center gap-2 mb-3 px-2.5 py-1 text-sm text-white/70 hover:text-white no-underline">
                    <span aria-hidden="true">←</span> Back to docs
                </a>

                <ul class="space-y-0.5">
                    {% for module in modules %}
                        {% set isActive = (module.name | lower) == module_name | lower %}
                        <li data-dsl-module="{{ module_name | slugify | lower }}">
                            <a href="{{ path('documentation_dsl', {module: module.name | lower, _fragment: 'dsl-functions'}) }}"
                               class="block rounded-md px-2.5 py-1.5 text-sm transition-colors no-underline border-l-2
                                      {{ isActive
                                        ? 'border-orange-100 bg-white/[0.06] text-white font-medium'
                                        : 'border-transparent text-white/70 hover:text-white hover:bg-white/[0.04]' }}"
                               {% if isActive %}aria-current="page"{% endif %}>
                                {{ module.value }}
                            </a>
                            {% if isActive %}
                                <ul class="mt-1 ml-3 pl-3 border-l border-white/10 space-y-0.5">
                                    {% for type in types %}
                                        {% if definitions.onlyType(type).count %}
                                            <li>
                                                <a href="#type-{{ type.name|lower }}"
                                                   class="block rounded-md px-2.5 py-1 text-xs text-white/65 hover:text-white hover:bg-white/[0.04] no-underline border-l-2 border-transparent">
                                                    {{ type.value }}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        </aside>

        <article class="order-1 lg:order-2 min-w-0">
            {% include 'partials/docs_mobile_nav.html.twig' with {currentPath: currentPath} %}

            <h1 class="font-bold text-3xl tracking-tight mb-3">DSL References</h1>
            <p class="muted mb-8 max-w-3xl">
                DSL stands for Domain Specific Language. In Flow, the DSL is a set of small
                functions that wrap object construction so pipelines read top-to-bottom.
                See the <a class="text-blue-100 hover:text-orange-100" href="{{ path('example', {topic: 'data_frame', example: 'data_frame', _fragment: 'example'}) }}">examples</a>
                for usage in context.
            </p>

            {% for type in types %}
                {% if definitions.onlyType(type).count %}
                    <section class="mb-10">
                        <h2 id="type-{{ type.name|lower }}"
                            class="font-bold text-2xl tracking-tight mb-4 scroll-mt-24"
                            data-dsl-type="{{ type.value }}">
                            <a href="#type-{{ type.name|lower }}" class="text-white no-underline hover:text-orange-100">
                                {{ type.name }}
                            </a>
                        </h2>

                        <div class="space-y-4">
                            {% for definition in definitions.onlyType(type).all %}
                                <article data-dsl-function class="card !p-0 overflow-hidden">
                                    <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-white/10 bg-white/[0.02]">
                                        <h3 class="m-0 font-mono text-sm font-medium" id="dsl-{{ definition.name }}">
                                            <a href="{{ path('documentation_dsl_function', {module: definition.module.name | lower, function: definition.name | slugify | lower, _fragment: 'dsl-function'}) }}"
                                               class="inline-flex items-center gap-2 text-white no-underline hover:text-orange-100">
                                                <img src="{{ asset('images/icons/link.svg') }}" alt="" width="14" height="14" class="opacity-60">
                                                {{ definition.name }}
                                            </a>
                                        </h3>
                                        <a class="inline-flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.04] hover:border-white/20 hover:bg-white/[0.08] px-2.5 py-1 text-xs text-white/85 no-underline transition-colors"
                                           href="{{ definition.githubUrl }}" target="_blank" rel="noopener" data-dsl-source-link>
                                            View
                                            <img src="{{ asset('images/icons/github.svg') }}" alt="" width="12" height="12" class="opacity-70">
                                        </a>
                                    </div>
                                    {% apply spaceless %}
                                    <pre class="!m-0 !rounded-none !border-0 !bg-transparent overflow-auto language-php text-sm leading-6 px-5 py-4"
                                         {{ stimulus_controller('syntax_highlight') }} data-prismjs-no-auto-linker><code>{{- definition.toString | escape('html') -}}</code></pre>
                                    {% endapply %}
                                </article>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endfor %}
        </article>

        <aside class="hidden lg:block order-3">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight', {currentPath: currentPath})) }}
        </aside>
    </div>
</section>
{% endblock %}
