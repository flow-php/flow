{% extends 'base_wide.html.twig' %}

{%- block title -%}
    {{ page.title }} - Flow PHP - Data Processing Framework
{%- endblock -%}

{%- block description -%}
    {{ page.description }}
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
{% set currentPath = app.request.pathInfo %}

{% include 'partials/docs_mobile_nav_panel.html.twig' with {currentPath: currentPath} %}

<section class="px-4 sm:px-6 lg:px-8 xl:px-12 mt-6 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)_14rem] xl:grid-cols-[18rem_minmax(0,1fr)_16rem] gap-8 lg:gap-10">

        <aside class="hidden lg:block lg:order-1">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationLeft', {currentPath: currentPath})) }}
        </aside>

        <article id="documentation-page" class="order-1 lg:order-2 min-w-0" data-pagefind-body>
            {% include 'partials/docs_mobile_nav.html.twig' with {currentPath: currentPath} %}

            {% if searchFacets.type|default(null) %}<span data-pagefind-filter="type:{{ searchFacets.type }}" class="hidden" aria-hidden="true"></span>{% endif %}
            {% if searchFacets.component|default(null) %}<span data-pagefind-filter="component:{{ searchFacets.component }}" class="hidden" aria-hidden="true"></span>{% endif %}

            {{ page.content|markdown_to_html }}

            <p class="!mt-12 !mb-8 text-sm text-slate-500 dark:text-white/55" data-pagefind-ignore>
                Found a typo or an outdated section?
                <a class="inline-flex items-center gap-1 text-slate-700 hover:text-slate-900 !no-underline dark:text-white/80 dark:hover:text-white"
                   href="{{ page.editOnGitHubUrl }}" target="_blank" rel="noopener">
                    Edit this page on GitHub
                    <span aria-hidden="true">↗</span>
                </a>
            </p>

            <hr class="!my-8" data-pagefind-ignore/>

            <script src="https://giscus.app/client.js"
                    data-repo="flow-php/flow-php.com"
                    data-repo-id="R_kgDOHja2Yg"
                    data-category="Documentation"
                    data-category-id="DIC_kwDOHja2Ys4Cidc1"
                    data-mapping="url"
                    data-strict="0"
                    data-reactions-enabled="0"
                    data-emit-metadata="0"
                    data-input-position="bottom"
                    data-theme="preferred_color_scheme"
                    data-lang="en"
                    crossorigin="anonymous"
                    async>
            </script>
        </article>

        <aside class="hidden lg:block order-3">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight', {currentPath: currentPath})) }}
        </aside>
    </div>
</section>
{% endblock %}
