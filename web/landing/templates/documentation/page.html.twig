{% extends 'base_wide.html.twig' %}

{%- block title -%}
    {{ page.title }} - Flow PHP - Data Processing Framework
{%- endblock -%}

{%- block description -%}
    {{ page.description }}
{%- endblock -%}

{%- block hero -%}
{% endblock %}

{% block main %}
<section id="documentation-page" class="mt-5 mb-5 px-4 lg:px-8 xl:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_1fr_14rem] xl:grid-cols-[18rem_1fr_16rem] gap-4">
        <div class="order-1 lg:order-0 lg:sticky lg:top-0 lg:max-h-screen lg:overflow-y-auto lg:pr-4">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationLeft')) }}
        </div>
        <div class="order-3 lg:order-1 min-w-0 py-2 px-4 lg:px-8">
            <hr class="lg:hidden"/>

            <div class="mb-3 text-left">
                <a class="btn btn-primary" href="{{ page.editOnGitHubUrl }}" target="_blank">
                    Edit
                    <img src="{{ asset('images/icons/github.svg') }}" alt="external resource" width="16" height="16" class="ml-1">
                </a>
            </div>

            {{ page.content|markdown_to_html }}

            <hr class="!mt-8 !mb-8"/>

            <script src="https://giscus.app/client.js"
                    data-repo="flow-php/flow-php.com"
                    data-repo-id="R_kgDOHja2Yg"
                    data-category="Documentation"
                    data-category-id="DIC_kwDOHja2Ys4Cidc1"
                    data-mapping="url"
                    data-strict="0"
                    data-reactions-enabled="0"
                    data-emit-metadata="0"
                    data-input-position="bottom"
                    data-theme="dark"
                    data-lang="en"
                    crossorigin="anonymous"
                    async>
            </script>
        </div>
        <div class="order-2 lg:order-2 lg:sticky lg:top-0 lg:max-h-screen lg:overflow-y-auto lg:pl-4">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight')) }}
        </div>
    </div>
</section>
{% endblock %}