{% extends 'base_wide.html.twig' %}

{%- block title -%}
    {{ definition.name }} - function - DSL - Flow PHP
{%- endblock -%}

{%- block description -%}
    {{ definition.name }} - function documentation - Documentation - DSL
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
{% set currentPath = app.request.pathInfo %}
<section class="px-4 sm:px-6 lg:px-8 xl:px-12 mt-6 mb-12" data-hx-boost="true">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)_14rem] xl:grid-cols-[18rem_minmax(0,1fr)_16rem] gap-8 lg:gap-10">

        <aside class="order-2">
            <nav aria-label="DSL modules">
                <h2 class="px-2.5 mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
                    DSL References
                </h2>

                <a href="{{ path('documentation_dsl', {module: module_name | lower, _fragment: 'dsl-functions'}) }}"
                   class="inline-flex items-center gap-2 mb-3 px-2.5 py-1 text-sm text-white/70 hover:text-white no-underline">
                    <span aria-hidden="true">←</span> Back to {{ module_name|humanize }}
                </a>

                <ul class="space-y-0.5">
                    {% for module in modules %}
                        {% set isActive = (module.name | lower) == module_name | lower %}
                        <li>
                            <a href="{{ path('documentation_dsl', {module: module.name | lower, _fragment: 'dsl-functions'}) }}"
                               class="block rounded-md px-2.5 py-1.5 text-sm transition-colors no-underline border-l-2
                                      {{ isActive
                                        ? 'border-orange-100 bg-white/[0.06] text-white font-medium'
                                        : 'border-transparent text-white/70 hover:text-white hover:bg-white/[0.04]' }}">
                                {{ module.value }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        </aside>

        <article class="order-1 lg:order-2 min-w-0">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                DSL · {{ module_name|humanize }}
            </span>
            <h1 id="dsl-function" class="mt-3 text-3xl font-bold tracking-tight mb-4">
                <span class="font-mono">{{ definition.name }}</span>
            </h1>

            <div class="flex gap-2 mb-6">
                <a class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] hover:border-white/20 hover:bg-white/[0.08] px-3 py-1.5 text-sm font-medium text-white/85 transition-colors no-underline"
                   href="{{ definition.githubUrl }}" target="_blank" rel="noopener" data-dsl-source-link>
                    View on GitHub
                    <img src="{{ asset('images/icons/github.svg') }}" alt="" width="14" height="14" class="opacity-70">
                </a>
            </div>

            <h2 class="text-xl font-semibold tracking-tight mt-2 mb-3">Definition</h2>
            <article data-dsl-function class="card !p-0 overflow-hidden">
                {% apply spaceless %}
                <pre class="!m-0 !rounded-none !border-0 !bg-transparent overflow-auto language-php text-sm leading-6 px-5 py-4"><code class="language-php" data-prismjs-no-auto-linker {{ stimulus_controller('syntax_highlight') }}>{{- definition.toString | escape('html') -}}</code></pre>
                {% endapply %}
            </article>

            {% if examples|length %}
            <h2 class="text-xl font-semibold tracking-tight mt-10 mb-3">Usage examples</h2>
            <div class="space-y-5">
                {% for example in examples %}
                    <article class="card !p-0 overflow-hidden">
                        <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-white/10 bg-white/[0.02]">
                            <h3 class="m-0 text-sm font-medium">
                                <a class="text-white hover:text-orange-100 no-underline"
                                   href="{{ path('example', { topic: example.topic, example: example.name, '_fragment': 'example' }) }}">
                                    {{ example.topic|humanize }} · {{ example.name|humanize }}
                                </a>
                            </h3>
                            <button class="inline-flex items-center justify-center h-8 w-8 rounded-md border border-white/10 bg-black/40 hover:bg-black/70 text-white [&.copied]:before:content-['Copied!'] before:absolute before:-translate-x-20"
                                    title="copy code"
                                    aria-label="Copy code"
                                    data-clipboard-target="#example-code-{{ loop.index }}"
                                    {{ stimulus_controller('clipboard') }}>
                                <img src="{{ asset('images/icons/copy.svg') }}" alt="" width="14" height="14">
                            </button>
                        </div>
                        {% apply spaceless %}
                        <pre class="!m-0 !rounded-none !border-0 !bg-transparent overflow-auto language-php text-sm leading-6 px-5 py-4"><code id="example-code-{{ loop.index }}" class="language-php" data-controller="syntax-highlight">{{- example.code | escape('html') -}}</code></pre>
                        {% endapply %}
                    </article>
                {% endfor %}
            </div>
            {% endif %}

            <hr class="border-0 h-px bg-white/10 my-8"/>

            <script src="https://giscus.app/client.js"
                    data-repo="flow-php/flow-php.com"
                    data-repo-id="R_kgDOHja2Yg"
                    data-category="Documentation"
                    data-category-id="DIC_kwDOHja2Ys4Cidc1"
                    data-mapping="url"
                    data-strict="0"
                    data-reactions-enabled="0"
                    data-emit-metadata="0"
                    data-input-position="bottom"
                    data-theme="dark"
                    data-lang="en"
                    crossorigin="anonymous"
                    async>
            </script>
        </article>

        <aside class="order-3">
            {{ render(controller('Flow\\Website\\Controller\\DocumentationController::navigationRight', {currentPath: currentPath})) }}
        </aside>
    </div>
</section>
{% endblock %}
