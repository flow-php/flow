{% extends 'base.html.twig' %}

{%- block title -%}
    Sponsor - Flow PHP - Data Processing Framework
{%- endblock -%}

{%- block description -%}
    Flow PHP is open source under the MIT license. Sponsor the project to help us
    fund documentation, new features, and a sustainable roadmap.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-12 lg:mt-16">
        <div class="max-w-3xl">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                Sponsor
            </span>
            <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
                Help keep Flow growing.
            </h1>
            <p class="mt-5 muted text-lg leading-relaxed">
                Flow PHP is free and open source under the MIT license. If it saves
                you time at work, a sponsorship goes straight back into documentation,
                new features, and a sustainable roadmap.
            </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <article class="card flex flex-col">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-orange-100/10 ring-1 ring-orange-200/30 dark:bg-orange-100/15 dark:ring-orange-100/30">
                    <img src="{{ asset('images/icons/heart.svg') }}" alt="" width="20" height="20">
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight">Become a sponsor</h2>
                <p class="mt-2 muted text-sm leading-relaxed flex-1">
                    Flow PHP is MIT licensed and it is going to stay MIT — sponsoring never buys
                    features and never gates code. It buys maintainer time, and we appreciate even
                    the smallest help: $5 a month makes a real difference, and comes with the
                    Sponsor role on our Discord.
                </p>
                <a href="{{ path('work_shop') }}#sponsoring"
                   class="btn btn-primary mt-5 self-start px-4 py-2 no-underline">
                    <img src="{{ asset('images/icons/heart.svg') }}" alt="" width="16" height="16">
                    Become a sponsor
                </a>
            </article>

            <article class="card flex flex-col">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brown-100/10 ring-1 ring-brown-100/30 dark:bg-brown-100/15 dark:ring-brown-100/30">
                    <img src="{{ asset('images/icons/code.svg') }}" alt="" width="20" height="20" class="dark:invert-0 invert">
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight">Support by learning</h2>
                <p class="mt-2 muted text-sm leading-relaxed flex-1">
                    Buy a blueprint and both sides win: you learn from a real, running codebase
                    built to be read and pulled apart — a blueprint on purpose, not a finished
                    product — and the purchase funds maintenance the same way a sponsorship does.
                </p>
                <a href="{{ path('work_shop') }}#blueprints"
                   class="btn btn-secondary mt-5 self-start px-4 py-2 no-underline">
                    Browse blueprints <span aria-hidden="true">→</span>
                </a>
            </article>

            <article class="card flex flex-col">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-300/10 ring-1 ring-blue-300/30 dark:bg-blue-100/15 dark:ring-blue-100/30">
                    <img src="{{ asset('images/icons/users-group.svg') }}" alt="" width="20" height="20" class="dark:invert-0 invert">
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight">Hire me</h2>
                <p class="mt-2 muted text-sm leading-relaxed flex-1">
                    Hire me for consulting, workshops, or implementation support.
                    Engagements of 20+ hours include a sponsor logo on this page.
                </p>
                <a href="{{ path('work_shop_consulting') }}"
                   class="btn btn-secondary mt-5 self-start px-4 py-2 no-underline">
                    Learn more <span aria-hidden="true">→</span>
                </a>
            </article>
        </div>
    </section>

    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-16 lg:mt-24">
        <div class="max-w-2xl">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                Open Source Sponsors
            </span>
            <h2 class="mt-3 section-title">Backed by great companies.</h2>
            <p class="mt-3 muted">
                The companies below support Flow with services free of charge or significantly discounted.<br/>
                Thank you.
            </p>
        </div>

        {% set sponsors = [
            {url: 'https://www.anthropic.com/',                                                                                                       name: 'Anthropic',    slug: 'anthropic',     size: 'h-8'},
            {url: 'https://blacksmith.sh/',                                                                                                          name: 'Blacksmith',   slug: 'blacksmith',    size: 'h-8'},
            {url: 'https://www.datadoghq.com/',                                                                                                       name: 'Datadog',      slug: 'datadog',       size: 'h-24'},
            {url: 'https://www.digitalocean.com/?refcode=0313c3031eb9&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge',     name: 'DigitalOcean', slug: 'digitalocean',  size: 'h-24'},
            {url: 'https://blackfire.io/',                                                                                                            name: 'Blackfire',    slug: 'blackfire',     size: 'h-16'},
            {url: 'https://sentry.io',                                                                                                                name: 'Sentry',       slug: 'sentry',        size: 'h-10'},
            {url: 'https://cloudflare.com/',                                                                                                          name: 'Cloudflare',   slug: 'cloudflare',    size: 'h-9'},
            {url: 'https://tailscale.com/',                                                                                                           name: 'Tailscale',    slug: 'tailscale',     size: 'h-9'},
            {url: 'https://1password.com/',                                                                                                           name: '1Password',    slug: '1password',     size: 'h-10'},
        ] %}

        <div class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
            {% for sponsor in sponsors %}
                <a href="{{ sponsor.url }}" target="_blank" rel="noopener"
                   class="card card-hover flex h-44 items-center justify-center no-underline">
                    <img src="{{ asset('images/sponsors/' ~ sponsor.slug ~ '-light.svg') }}" alt="{{ sponsor.name }}" loading="lazy"
                         class="{{ sponsor.size }} max-w-[75%] w-auto object-contain dark:hidden"/>
                    <img src="{{ asset('images/sponsors/' ~ sponsor.slug ~ '-dark.svg') }}" alt="{{ sponsor.name }}" loading="lazy"
                         class="{{ sponsor.size }} max-w-[75%] w-auto object-contain hidden dark:block"/>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}
