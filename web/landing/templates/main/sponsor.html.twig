{% extends 'base.html.twig' %}

{%- block title -%}
    Sponsor - Flow PHP - Data Processing Framework
{%- endblock -%}

{%- block description -%}
    Flow PHP is open source under the MIT license. Sponsor the project to help us
    fund documentation, new features, and a sustainable roadmap.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-12 lg:mt-16">
        <div class="max-w-3xl">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                Sponsor
            </span>
            <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
                Help keep Flow growing.
            </h1>
            <p class="mt-5 muted text-lg leading-relaxed">
                Flow PHP is free and open source under the MIT license. If it saves
                you time at work, a sponsorship goes straight back into documentation,
                new features, and a sustainable roadmap.
            </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
            <article class="card flex flex-col">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-orange-100/15 ring-1 ring-orange-100/30">
                    <img src="{{ asset('images/icons/heart.svg') }}" alt="" width="20" height="20">
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight">Sponsor on GitHub</h2>
                <p class="mt-2 muted text-sm leading-relaxed flex-1">
                    Even a small one-time contribution makes a difference. Recurring
                    sponsorship is the most impactful — it lets us plan ahead.
                </p>
                <a href="https://github.com/sponsors/norberttech?frequency=one-time" target="_blank" rel="noopener"
                   class="btn btn-primary mt-5 self-start px-4 py-2">
                    <img src="{{ asset('images/icons/github.svg') }}" alt="" width="16" height="16">
                    Sponsor on GitHub
                </a>
            </article>

            <article class="card flex flex-col">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100/15 ring-1 ring-blue-100/30">
                    <img src="{{ asset('images/icons/users-group.svg') }}" alt="" width="20" height="20">
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight">Hire me</h2>
                <p class="mt-2 muted text-sm leading-relaxed flex-1">
                    Hire me for consulting, workshops, or implementation support.
                    Engagements of 20+ hours include a sponsor logo on this page.
                </p>
                <a href="https://norbert.tech/consulting" target="_blank" rel="noopener"
                   class="btn btn-secondary mt-5 self-start px-4 py-2 no-underline">
                    Learn more <span aria-hidden="true">→</span>
                </a>
            </article>
        </div>
    </section>

    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-16 lg:mt-24">
        <div class="max-w-2xl">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                Open Source Sponsors
            </span>
            <h2 class="mt-3 section-title">Backed by great companies.</h2>
            <p class="mt-3 muted">
                The companies below support Flow with services free of charge or significantly discounted. Thank you.
            </p>
        </div>

        {% set sponsors = [
            {url: 'https://www.datadoghq.com/',                                                                                                       name: 'Datadog',      img: asset('images/sponsors/datadog.png')},
            {url: 'https://www.digitalocean.com/?refcode=0313c3031eb9&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge',     name: 'DigitalOcean', img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/h_146,w_450/digital-ocean_slmm2i.svg'},
            {url: 'https://blackfire.io/',                                                                                                            name: 'Blackfire',    img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/c_fill,h_200/blackfire_xiugzv.png'},
            {url: 'https://sentry.io',                                                                                                                name: 'Sentry',       img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/h_200/sentry_ai9hi6.svg'},
            {url: 'https://cloudflare.com/',                                                                                                          name: 'Cloudflare',   img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/c_fill,h_200/cloudflare_logjlf.png'},
            {url: 'https://tailscale.com/',                                                                                                           name: 'Tailscale',    img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/c_fill,h_200/tailscale_biexgf.png',  light: true},
            {url: 'https://1password.com/',                                                                                                           name: '1Password',    img: 'https://res.cloudinary.com/df2cy8zhc/image/upload/c_fill,h_200/1Password_sjoj4n.png'},
        ] %}

        <div class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
            {% for sponsor in sponsors %}
                <a href="{{ sponsor.url }}" target="_blank" rel="noopener"
                   class="card card-hover flex h-44 items-center justify-center no-underline {{ sponsor.light|default(false) ? '!bg-white/95 hover:!bg-white' : '' }}">
                    <img src="{{ sponsor.img }}" alt="{{ sponsor.name }}" loading="lazy"
                         class="max-h-20 max-w-[80%] w-auto h-auto object-contain"/>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}
