{#
Parameters:
   - initial_code: string|null - PHP code to pre-load (optional)
   - show_share: bool - Whether to show share button (default: true)
   - back_url: string|null - URL for "Back to Example" link (optional)
   - back_label: string|null - Label for back link (optional)
   - data_files: array - Map of virtual paths to relative paths for example data files (optional)
   - topic: string|null - Current topic (required for data_files)
   - example: string|null - Current example (required for data_files)
   - option: string|null - Current option (optional)
#}
{% set show_share = show_share|default(true) %}
{% set wasm_resources = {
    'code.php': asset('wasm/code.php.wasm'),
    'tools/flow.phar': asset('wasm/tools/flow.phar'),
    'tools/php-cs-fixer.phar': asset('wasm/tools/php-cs-fixer.phar'),
    'vendor/autoload.php': asset('wasm/vendor/autoload.php.wasm'),
    '.php-cs-fixer.php': asset('wasm/phpcsfixer.php.wasm'),
    'bin/cs-fixer.php': asset('wasm/bin/cs-fixer.php.wasm'),
    'data/orders.xml': asset('wasm/data/orders.xml'),
    'data/orders.json': asset('wasm/data/orders.json'),
    'data/orders.csv': asset('wasm/data/orders.csv'),
    'data/orders.parquet': asset('wasm/data/orders.parquet')
} %}
{% for virtualPath, relativePath in data_files|default({}) %}
    {% if option is defined and option is not null %}
        {% set wasm_resources = wasm_resources|merge({(virtualPath): path('example_option_data', {topic: topic, example: example, option: option, path: relativePath})}) %}
    {% else %}
        {% set wasm_resources = wasm_resources|merge({(virtualPath): path('example_data', {topic: topic, example: example, path: relativePath})}) %}
    {% endif %}
{% endfor %}
<div id="playground"
     data-controller="wasm turnstile playground-output playground playground-workspace playground-run playground-format playground-upload playground-share playground-storage playground-reset playground-help"
     data-turnstile-site-key-value="{{ turnstile_site_key }}"
     data-turnstile-appearance-value="{{ turnstile_appearance }}"
     data-turnstile-environment-value="{{ app.environment }}"
     data-playground-share-api-url-value="{{ playground_api_url }}"
     data-playground-share-snippets-url-value="{{ playground_snippets_url }}"
     {% if initial_code is defined and initial_code is not null %}
     data-playground-share-is-example-value="true"
     {% endif %}
     data-wasm-php-js-value="{{ asset('wasm/php.js') }}"
     data-wasm-php-wasm-value="{{ asset('wasm/php.wasm') }}"
     data-wasm-resources-value="{{ wasm_resources|json_encode }}"
     data-playground-package-icon-value="{{ asset('images/icons/package.svg') }}"
     data-playground-link-icon-value="{{ asset('images/icons/link.svg') }}"
     data-playground-example-icon-value="{{ asset('images/icons/flow.svg') }}"
     data-playground-workspace-wasm-outlet="#playground"
     data-playground-workspace-code-editor-outlet="#code-editor"
     data-playground-workspace-playground-outlet="#playground"
     data-playground-workspace-folder-icon-value="{{ asset('images/icons/folder.svg') }}"
     data-playground-workspace-file-icon-value="{{ asset('images/icons/file.svg') }}"
     data-playground-upload-folder-icon-value="{{ asset('images/icons/folder.svg') }}"
     data-playground-upload-file-icon-value="{{ asset('images/icons/file.svg') }}"
     data-playground-wasm-outlet="#playground"
     data-playground-code-editor-outlet="#code-editor"
     data-playground-turnstile-outlet="#playground"
     data-playground-playground-output-outlet="#playground"
     data-playground-run-code-editor-outlet="#code-editor"
     data-playground-run-wasm-outlet="#playground"
     data-playground-run-playground-output-outlet="#playground"
     data-playground-format-code-editor-outlet="#code-editor"
     data-playground-format-wasm-outlet="#playground"
     data-playground-format-playground-output-outlet="#playground"
     data-playground-upload-wasm-outlet="#playground"
     data-playground-upload-playground-output-outlet="#playground"
     data-playground-share-code-editor-outlet="#code-editor"
     data-playground-share-wasm-outlet="#playground"
     data-playground-share-turnstile-outlet="#playground"
     data-playground-share-playground-upload-outlet="#playground"
     data-playground-storage-code-editor-outlet="#code-editor"
     data-playground-storage-wasm-outlet="#playground"
     {% if initial_code is defined and initial_code is not null %}
     data-playground-storage-initial-code-value="{{ initial_code|e('html_attr') }}"
     {% endif %}
     data-playground-reset-playground-storage-outlet="#playground"
     data-playground-playground-tabs-outlet="#playground-editor"
     data-action="wasm:initialized->playground#onWasmInitialized
                  wasm:initialized->playground-workspace#refreshTree
                  wasm:initialized->playground-share#onWasmResourcesLoaded
                  wasm:initialized->playground-storage#onWasmResourcesLoaded
                  wasm:loading-progress->playground#onWasmLoadingProgress
                  wasm:output->playground#onWasmOutput
                  wasm:error->playground#onWasmError
                  playground-storage:loaded-from-storage->playground#onStorageLoaded
                  playground-storage:loaded-from-example->playground#onExampleLoaded
                  playground-share:loaded-from-url->playground#onUrlLoaded
                  playground-share:datasets-loaded->playground#onDatasetsLoaded
                  playground-share:notification->playground#onNotification
                  playground-run:action-started->playground#onActionStarted
                  playground-run:action-finished->playground#onActionFinished
                  playground-format:action-started->playground#onActionStarted
                  playground-format:action-finished->playground#onActionFinished
                  playground-share:action-started->playground#onActionStarted
                  playground-share:action-finished->playground#onActionFinished
                  playground-upload:action-started->playground#onActionStarted
                  playground-upload:action-finished->playground#onActionFinished
                  playground-run:action-started->playground-workspace#onActionStarted
                  playground-run:action-finished->playground-workspace#onActionFinished
                  playground-format:action-started->playground-workspace#onActionStarted
                  playground-format:action-finished->playground-workspace#onActionFinished
                  playground-share:action-started->playground-workspace#onActionStarted
                  playground-share:action-finished->playground-workspace#onActionFinished
                  playground-upload:action-started->playground-workspace#onActionStarted
                  playground-upload:action-finished->playground-workspace#onActionFinished">
    <div class="playground-header">
        <h1>Playground</h1>
        {% if back_url is defined and back_url is not null %}
        <a href="{{ back_url }}" class="back-link">
            <img src="{{ asset('images/icons/arrow-left.svg') }}" alt="" width="16" height="16">
            {{ back_label|default('Back') }}
        </a>
        {% endif %}
        <button
                data-action="click->playground-help#showTopic"
                data-help-topic="help-about"
                class="help-trigger mb-4"
                aria-label="What is Flow Playground?">
            <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="20" height="20">
        </button>
    </div>

    <div id="turnstile-widget" class="mb-5 max-w-[550px]"></div>

    <div id="help-section"
         data-playground-help-target="helpSection"
         style="display: none;">
        <div class="help-header">
            <h2>Help</h2>
            <button data-action="click->playground-help#close" class="help-close" aria-label="Close help">×</button>
        </div>
        <div class="help-content">
            <section class="help-topic" id="help-about">
                <h3>Flow PHP Playground</h3>
                <p>
                    Flow Playground is an interactive WebAssembly-based environment that runs Flow PHP directly in your browser.<br/>
                    This means that any code you execute in the editor below, runs in your browser, using a version of php compiled to WebAssembly.<br/>
                    Other than that, it's just a regular PHP environment.
                </p>
                <p>
                    <strong>Under Development:</strong> This playground is still under active development. <br/>
                    If you encounter any bugs or have feedback, we'd love to hear from you! Please report issues on <a href="https://github.com/flow-php/flow" target="_blank">GitHub</a> or reach out to us on <a href="https://discord.gg/fAv6Xa6RNr" target="_blank">Discord</a>.

                </p>
            </section>

            <section class="help-topic" id="help-navigation">
                <h3>Action Buttons</h3>
                <ul>
                    <li><strong>Run</strong> - Executes your PHP code in the playground and displays the output below the editor.</li>
                    <li><strong>Format</strong> - Automatically formats your PHP code using PHP-CS-Fixer rules for consistent code style.</li>
                    <li><strong>Share</strong> - Generates a shareable link by securely uploading your code to our server. Your code and any uploaded datasets are stored for 90 days and accessible via a short URL. You can include up to 3 datasets (CSV, JSON, or XML files, max 2MB each) in your share. <br/><em>Important: Never include sensitive information like passwords, API keys, or personal data in your code when sharing. Shared snippets are publicly accessible to anyone with the link.</em></li>
                    <li><strong>Upload</strong> - Upload local files (CSV, JSON, XML, PHP, PHAR) to the virtual WASM filesystem. You can upload up to 3 files (max 2MB each). When you share your code, uploaded datasets will be included automatically. <br/><em>Note: Uploaded files are stored only in your browser's memory and will disappear when you refresh the page, unless you share your code.</em></li>
                    <li><strong>Reset</strong> - Clears your code and resets the playground to its default state.</li>
                </ul>
            </section>

            <section class="help-topic" id="help-workspace">
                <h3>Workspace</h3>
                <p>
                    The Workspace panel displays the contents of the <code>/workspace</code> folder from the WebAssembly virtual filesystem. This is where your code and uploaded files are stored during your playground session.
                </p>
                <p>
                    All files in the workspace are stored locally in your browser's memory and are never uploaded to any server. <br/>
                    This means you can safely experiment with real datasets and documents without any privacy concerns. <br/>
                    However, keep in mind that all files will be lost when you refresh the page or close your browser.
                </p>
                <p>
                    <ul>
                        <li><code>bin</code> - this is where we keep scripts used by playground, like for exampel code formatter</li>
                        <li><code>data</code> - here you can find sample datasets to play with, reference them as <code>__DIR__ . '/data/orders.csv</code></li>
                        <li><code>tmp</code> - this is where we are going to upload your files</li>
                        <li><code>vendor</code> - place for playground dependencies and autoloader</li>
                        <li><code>tools</code> - place for playground tools, like <code>flow.phar</code></li>
                    </ul>
                </p>
            </section>
        </div>
    </div>

    <div id="loader">
        <div data-playground-target="loadingMessage"></div>
        <div class="loading-progress">
            <div data-playground-target="loadingBar" class="loading-bar"></div>
        </div>
        <div data-playground-target="loadingPercent"></div>
    </div>

    <div class="navigation" data-playground-target="navigation">
        <div class="storage-indicator" data-playground-target="storageIndicator" style="display: none;"></div>
        <div class="actions">
            <span id="action-spinner" class="action-spinner hidden" data-playground-target="actionSpinner">
                <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
            <button
                    data-action="click->playground-help#showTopic"
                    data-help-topic="help-navigation"
                    class="help-trigger-nav pt-2"
                    aria-label="What do these buttons do?">
                <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="18" height="18">
            </button>
            <button
                    id="action-run"
                    data-controller="image-swap"
                    data-action="click->playground-run#run mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Run <img src="{{ asset('images/icons/play.svg') }}"
                         alt="Run"
                         class="ml-1 inline-block"
                         data-image-swap-target="image"
                         data-hover-src="{{ asset('images/icons/play-active.svg') }}">
            </button>
            <button
                    id="action-format"
                    data-controller="image-swap"
                    data-action="click->playground-format#format mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Format <img src="{{ asset('images/icons/code.svg') }}"
                            alt="Format"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/code-active.svg') }}">
            </button>
            {% if show_share %}
            <button
                    id="action-share"
                    data-controller="image-swap"
                    data-action="click->playground-share#share mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Share <img src="{{ asset('images/icons/share.svg') }}"
                     alt="Share"
                     class="ml-1 inline-block"
                     data-image-swap-target="image"
                     data-hover-src="{{ asset('images/icons/share-active.svg') }}">
            </button>
            {% endif %}
            <button
                    id="action-upload"
                    data-controller="image-swap"
                    data-action="click->playground-upload#triggerUpload mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Upload <img src="{{ asset('images/icons/upload.svg') }}"
                            alt="Upload"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/upload-active.svg') }}">
            </button>
            <input type="file"
                   data-playground-upload-target="fileInput"
                   data-action="change->playground-upload#handleFileUpload"
                   accept=".csv,.json,.xml,.php,.phar"
                   multiple
                   style="display: none;">
            <a href="{{ path('playground') }}"
               id="action-reset"
               data-controller="image-swap playground-reset"
               data-playground-reset-playground-storage-outlet="#playground"
               data-action="click->playground-reset#confirmReset mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Reset <img src="{{ asset('images/icons/refresh.svg') }}"
                           alt="Reset"
                           class="ml-1 inline-block"
                           data-image-swap-target="image"
                           data-hover-src="{{ asset('images/icons/refresh-active.svg') }}">
            </a>
        </div>
    </div>
    <div id="playground-editor" class="editor" data-playground-target="editor"
         data-controller="playground-tabs"
         data-playground-tabs-wasm-outlet="#playground"
         data-playground-tabs-code-editor-outlet="#code-editor">
        <div class="file-browser-mobile">
            <label for="file-select" class="file-browser-label">
                Workspace
                <button
                        data-action="click->playground-help#showTopic"
                        data-help-topic="help-workspace"
                        class="help-trigger-workspace"
                        aria-label="What is the Workspace?">
                    <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="14" height="14">
                </button>
            </label>
            <select id="file-select"
                    class="file-select"
                    data-playground-workspace-target="dropdown"
                    data-action="change->playground-tabs#openFileFromDropdown">
                <option value="">Select a file...</option>
            </select>
        </div>
        <div class="file-browser">
            <div class="file-browser-header">
                Workspace
                <button
                        data-action="click->playground-help#showTopic"
                        data-help-topic="help-workspace"
                        class="help-trigger-workspace"
                        aria-label="What is the Workspace?">
                    <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="14" height="14">
                </button>
            </div>
            <div class="file-browser-content" data-playground-workspace-target="tree">
                <!-- Files will be populated by JavaScript -->
            </div>
        </div>
        <div class="editor-main">
            <div class="code-container">
                <div class="tab-bar" data-playground-tabs-target="tabBar">
                    <button class="tab active"
                            data-playground-tabs-target="codeTab"
                            data-action="click->playground-tabs#switchToCode">
                        <img src="{{ asset('images/icons/file.svg') }}" alt="" width="14" height="14">
                        <span>code.php</span>
                    </button>
                    <button class="tab"
                            data-playground-tabs-target="previewTab"
                            data-action="click->playground-tabs#switchToPreview"
                            style="display: none;">
                        <img src="{{ asset('images/icons/file.svg') }}" alt="" width="14" height="14">
                        <span data-playground-tabs-target="previewTabName"></span>
                        <span class="tab-close" data-action="click->playground-tabs#closePreview">&times;</span>
                    </button>
                    <button class="tab-action"
                            data-action="click->playground-tabs#downloadPreviewFile"
                            data-playground-tabs-target="downloadBtn"
                            style="display: none;"
                            aria-label="Download file">
                        <img src="{{ asset('images/icons/upload.svg') }}" alt="Download" width="14" height="14" style="transform: rotate(180deg);">
                    </button>
                </div>
                <div class="editor-panel" data-playground-tabs-target="codePanel">
                    <textarea id="code-editor" data-controller="code-editor">
<?php
// Code will be loaded from /workspace/code.php after WASM initialization
</textarea>
                </div>
                <div class="editor-panel" data-playground-tabs-target="previewPanel" style="display: none;"></div>
            </div>
            <div class="output-container" data-playground-target="outputContainer">
                <h2>Output</h2>
                <pre id="output" data-playground-output-target="container"></pre>
            </div>
        </div>
    </div>
</div>
