{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - Playground
{%- endblock -%}

{%- block description -%}
    Flow PHP in Browser - An interactive playground to experiment with Flow PHP, a PHP-based, strongly typed data processing framework with low memory footprint.
{%- endblock -%}

{% block hero %}
{% endblock %}

{% block main %}
{% set wasm_resources = {
    'tools/flow.phar': asset('wasm/tools/flow.phar'),
    'tools/php-cs-fixer.phar': asset('wasm/tools/php-cs-fixer.phar'),
    'vendor/autoload.php': asset('wasm/vendor/autoload.php.wasm'),
    '.php-cs-fixer.php': asset('wasm/_php-cs-fixer.php.wasm'),
    'bin/cs-fixer.php': asset('wasm/bin/cs-fixer.php.wasm'),
    'data/orders.xml': asset('wasm/data/orders.xml'),
    'data/orders.json': asset('wasm/data/orders.json'),
    'data/orders.csv': asset('wasm/data/orders.csv')
} %}
<div id="playground"
     data-controller="playground-editor wasm share-code playground-storage"
     data-playground-editor-code-mirror-editor-outlet="#code-editor"
     data-playground-editor-playground-storage-outlet="#playground"
     data-playground-storage-code-mirror-editor-outlet="#code-editor"
     data-share-code-code-mirror-editor-outlet="#code-editor"
     data-wasm-php-js-value="{{ asset('wasm/php.js') }}"
     data-wasm-php-wasm-value="{{ asset('wasm/php.wasm') }}"
     data-wasm-resources-value="{{ wasm_resources|json_encode }}"
     data-action="wasm:ready->playground-editor#onWasmReady
                  wasm:resources-loaded->playground-editor#onWasmResourcesLoaded
                  wasm:progress->playground-editor#onWasmProgress
                  wasm:output->playground-editor#onWasmOutput
                  wasm:error->playground-editor#onWasmError
                  playground-storage:loaded-from-storage->playground-editor#onStorageLoaded
                  share-code:loaded-from-url->playground-editor#onUrlLoaded">
    <h1>Playground</h1>

    <div id="loader">
        <div data-playground-editor-target="loadingMessage"></div>
        <div class="loading-progress">
            <div data-playground-editor-target="loadingBar" class="loading-bar"></div>
        </div>
        <div data-playground-editor-target="loadingPercent"></div>
    </div>

    <div class="navigation" data-playground-editor-target="navigation">
        <div class="storage-indicator" data-playground-editor-target="storageIndicator" style="display: none;"></div>
        <div class="actions">
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="runButton"
                    data-action="click->playground-editor#run mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Run <img src="{{ asset('images/icons/play.svg') }}"
                         alt="Run"
                         class="ml-1 inline-block"
                         data-image-swap-target="image"
                         data-hover-src="{{ asset('images/icons/play-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="formatButton"
                    data-action="click->playground-editor#format mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Format <img src="{{ asset('images/icons/code.svg') }}"
                            alt="Format"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/code-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-action="click->share-code#share mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Share <img src="{{ asset('images/icons/share.svg') }}"
                     alt="Share"
                     class="ml-1 inline-block"
                     data-image-swap-target="image"
                     data-hover-src="{{ asset('images/icons/share-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="uploadButton"
                    data-action="click->playground-editor#triggerUpload mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Upload <img src="{{ asset('images/icons/upload.svg') }}"
                            alt="Upload"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/upload-active.svg') }}">
            </button>
            <input type="file"
                   data-playground-editor-target="fileInput"
                   data-action="change->playground-editor#handleFileUpload"
                   accept=".csv,.json,.xml,.php,.phar"
                   multiple
                   style="display: none;">
            <a href="{{ path('playground') }}"
               data-controller="image-swap reset-confirm"
               data-reset-confirm-playground-storage-outlet="#playground"
               data-action="click->reset-confirm#confirmReset mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Reset <img src="{{ asset('images/icons/refresh.svg') }}"
                           alt="Reset"
                           class="ml-1 inline-block"
                           data-image-swap-target="image"
                           data-hover-src="{{ asset('images/icons/refresh-active.svg') }}">
            </a>
        </div>
    </div>
    <div class="editor" data-playground-editor-target="editor">
        <div class="file-browser" data-playground-editor-target="fileBrowser">
            <div class="file-browser-header">Files</div>
            <div class="file-browser-content" data-playground-editor-target="fileBrowserContent">
                <!-- Files will be populated by JavaScript -->
            </div>
        </div>
        <div class="code-container">
                <textarea id="code-editor" data-controller="code-mirror-editor">
<?php

declare(strict_types=1);
use Flow\ETL\Flow;

use function Flow\ETL\Adapter\CSV\from_csv;
use function Flow\ETL\DSL\{data_frame, to_output};

require_once 'vendor/autoload.php';

$flow = new Flow();

data_frame()
    ->read(from_csv(__DIR__ . '/data/orders.csv'))
    ->limit(10)
    ->collect()
    ->write(to_output(truncate: false))
    ->run();
</textarea>
        </div>
    </div>
    <div class="output-container" data-playground-editor-target="outputContainer">
        <h2>Output</h2>
        <pre id="output" data-playground-editor-target="output"></pre>
    </div>
</div>
{% endblock %}