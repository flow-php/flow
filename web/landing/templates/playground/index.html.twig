{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - Playground
{%- endblock -%}

{%- block description -%}
    Flow PHP in Browser - An interactive playground to experiment with Flow PHP, a PHP-based, strongly typed data processing framework with low memory footprint.
{%- endblock -%}

{% block hero %}
{% endblock %}

{% block main %}
{% set wasm_resources = {
    'tools/flow.phar': asset('wasm/tools/flow.phar'),
    'tools/php-cs-fixer.phar': asset('wasm/tools/php-cs-fixer.phar'),
    'vendor/autoload.php': asset('wasm/vendor/autoload.php.wasm'),
    '.php-cs-fixer.php': asset('wasm/phpcsfixer.php.wasm'),
    'bin/cs-fixer.php': asset('wasm/bin/cs-fixer.php.wasm'),
    'data/orders.xml': asset('wasm/data/orders.xml'),
    'data/orders.json': asset('wasm/data/orders.json'),
    'data/orders.csv': asset('wasm/data/orders.csv')
} %}
<div id="playground"
     data-controller="playground-editor wasm share-code playground-storage playground-help turnstile"
     data-turnstile-site-key="{{ turnstile_site_key }}"
     data-turnstile-appearance="{{ turnstile_appearance }}"
     data-share-code-api-url-value="{{ playground_api_url }}"
     data-share-code-snippets-url-value="{{ playground_snippets_url }}"
     data-playground-editor-code-mirror-editor-outlet="#code-editor"
     data-playground-editor-playground-storage-outlet="#playground"
     data-playground-storage-code-mirror-editor-outlet="#code-editor"
     data-share-code-code-mirror-editor-outlet="#code-editor"
     data-share-code-playground-editor-outlet="#playground"
     data-share-code-wasm-outlet="#playground"
     data-share-code-turnstile-outlet="#playground"
     data-wasm-php-js-value="{{ asset('wasm/php.js') }}"
     data-wasm-php-wasm-value="{{ asset('wasm/php.wasm') }}"
     data-wasm-resources-value="{{ wasm_resources|json_encode }}"
     data-playground-editor-package-icon-value="{{ asset('images/icons/package.svg') }}"
     data-playground-editor-link-icon-value="{{ asset('images/icons/link.svg') }}"
     data-playground-editor-folder-icon-value="{{ asset('images/icons/folder.svg') }}"
     data-playground-editor-file-icon-value="{{ asset('images/icons/file.svg') }}"
     data-action="wasm:ready->playground-editor#onWasmReady
                  wasm:resources-loaded->playground-editor#onWasmResourcesLoaded
                  wasm:progress->playground-editor#onWasmProgress
                  wasm:output->playground-editor#onWasmOutput
                  wasm:error->playground-editor#onWasmError
                  playground-storage:loaded-from-storage->playground-editor#onStorageLoaded
                  share-code:loaded-from-url->playground-editor#onUrlLoaded
                  share-code:datasets-loaded->playground-editor#onDatasetsLoaded
                  share-code:notification->playground-editor#onNotification">
    <div class="playground-header">
        <h1>Playground</h1>
        <button
                data-action="click->playground-help#showTopic"
                data-help-topic="help-about"
                class="help-trigger mb-4"
                aria-label="What is Flow Playground?">
            <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="20" height="20">
        </button>
    </div>

    <div id="turnstile-widget" class="mb-5 max-w-[550px]"></div>

    <div id="help-section"
         data-playground-help-target="helpSection"
         style="display: none;">
        <div class="help-header">
            <h2>Help</h2>
            <button data-action="click->playground-help#close" class="help-close" aria-label="Close help">×</button>
        </div>
        <div class="help-content">
            <section class="help-topic" id="help-about">
                <h3>Flow PHP Playground</h3>
                <p>
                    Flow Playground is an interactive WebAssembly-based environment that runs Flow PHP directly in your browser.<br/>
                    This means that any code you execute in the editor below, runs in your browser, using a version of php compiled to WebAssembly.<br/>
                    Other than that, it's just a regular PHP environment.
                </p>
                <p>
                    <strong>Under Development:</strong> This playground is still under active development. <br/>
                    If you encounter any bugs or have feedback, we'd love to hear from you! Please report issues on <a href="https://github.com/flow-php/flow" target="_blank">GitHub</a> or reach out to us on <a href="https://discord.gg/fAv6Xa6RNr" target="_blank">Discord</a>.

                </p>
            </section>

            <section class="help-topic" id="help-navigation">
                <h3>Action Buttons</h3>
                <ul>
                    <li><strong>Run</strong> - Executes your PHP code in the playground and displays the output below the editor.</li>
                    <li><strong>Format</strong> - Automatically formats your PHP code using PHP-CS-Fixer rules for consistent code style.</li>
                    <li><strong>Share</strong> - Generates a shareable link by securely uploading your code to our server. Your code and any uploaded datasets are stored for 90 days and accessible via a short URL. You can include up to 3 datasets (CSV, JSON, or XML files, max 2MB each) in your share. <br/><em>Important: Never include sensitive information like passwords, API keys, or personal data in your code when sharing. Shared snippets are publicly accessible to anyone with the link.</em></li>
                    <li><strong>Upload</strong> - Upload local files (CSV, JSON, XML, PHP, PHAR) to the virtual WASM filesystem. You can upload up to 3 files (max 2MB each). When you share your code, uploaded datasets will be included automatically. <br/><em>Note: Uploaded files are stored only in your browser's memory and will disappear when you refresh the page, unless you share your code.</em></li>
                    <li><strong>Reset</strong> - Clears your code and resets the playground to its default state.</li>
                </ul>
            </section>

            <section class="help-topic" id="help-workspace">
                <h3>Workspace</h3>
                <p>
                    The Workspace panel displays the contents of the <code>/workspace</code> folder from the WebAssembly virtual filesystem. This is where your code and uploaded files are stored during your playground session.
                </p>
                <p>
                    All files in the workspace are stored locally in your browser's memory and are never uploaded to any server. <br/>
                    This means you can safely experiment with real datasets and documents without any privacy concerns. <br/>
                    However, keep in mind that all files will be lost when you refresh the page or close your browser.
                </p>
                <p>
                    <ul>
                        <li><code>bin</code> - this is where we keep scripts used by playground, like for exampel code formatter</li>
                        <li><code>data</code> - here you can find sample datasets to play with, reference them as <code>__DIR__ . '/data/orders.csv</code></li>
                        <li><code>tmp</code> - this is where we are going to upload your files</li>
                        <li><code>vendor</code> - place for playground dependencies and autoloader</li>
                        <li><code>tools</code> - place for playground tools, like <code>flow.phar</code></li>
                    </ul>
                </p>
            </section>
        </div>
    </div>

    <div id="loader">
        <div data-playground-editor-target="loadingMessage"></div>
        <div class="loading-progress">
            <div data-playground-editor-target="loadingBar" class="loading-bar"></div>
        </div>
        <div data-playground-editor-target="loadingPercent"></div>
    </div>

    <div class="navigation" data-playground-editor-target="navigation">
        <div class="storage-indicator" data-playground-editor-target="storageIndicator" style="display: none;"></div>
        <div class="actions">
            <button
                    data-action="click->playground-help#showTopic"
                    data-help-topic="help-navigation"
                    class="help-trigger-nav pt-2"
                    aria-label="What do these buttons do?">
                <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="18" height="18">
            </button>
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="runButton"
                    data-action="click->playground-editor#run mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Run <img src="{{ asset('images/icons/play.svg') }}"
                         alt="Run"
                         class="ml-1 inline-block"
                         data-image-swap-target="image"
                         data-hover-src="{{ asset('images/icons/play-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="formatButton"
                    data-action="click->playground-editor#format mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Format <img src="{{ asset('images/icons/code.svg') }}"
                            alt="Format"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/code-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-action="click->share-code#share mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Share <img src="{{ asset('images/icons/share.svg') }}"
                     alt="Share"
                     class="ml-1 inline-block"
                     data-image-swap-target="image"
                     data-hover-src="{{ asset('images/icons/share-active.svg') }}">
            </button>
            <button
                    data-controller="image-swap"
                    data-playground-editor-target="uploadButton"
                    data-action="click->playground-editor#triggerUpload mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Upload <img src="{{ asset('images/icons/upload.svg') }}"
                            alt="Upload"
                            class="ml-1 inline-block"
                            data-image-swap-target="image"
                            data-hover-src="{{ asset('images/icons/upload-active.svg') }}">
            </button>
            <input type="file"
                   data-playground-editor-target="fileInput"
                   data-action="change->playground-editor#handleFileUpload"
                   accept=".csv,.json,.xml,.php,.phar"
                   multiple
                   style="display: none;">
            <a href="{{ path('playground') }}"
               data-controller="image-swap reset-confirm"
               data-reset-confirm-playground-storage-outlet="#playground"
               data-action="click->reset-confirm#confirmReset mouseenter->image-swap#mouseEnter mouseleave->image-swap#mouseLeave">
                Reset <img src="{{ asset('images/icons/refresh.svg') }}"
                           alt="Reset"
                           class="ml-1 inline-block"
                           data-image-swap-target="image"
                           data-hover-src="{{ asset('images/icons/refresh-active.svg') }}">
            </a>
        </div>
    </div>
    <div class="editor" data-playground-editor-target="editor">
        <div class="file-browser" data-playground-editor-target="fileBrowser">
            <div class="file-browser-header">
                Workspace
                <button
                        data-action="click->playground-help#showTopic"
                        data-help-topic="help-workspace"
                        class="help-trigger-workspace"
                        aria-label="What is the Workspace?">
                    <img src="{{ asset('images/icons/help.svg') }}" alt="Help" width="14" height="14">
                </button>
            </div>
            <div class="file-browser-content" data-playground-editor-target="fileBrowserContent">
                <!-- Files will be populated by JavaScript -->
            </div>
        </div>
        <div class="code-container">
                <textarea id="code-editor" data-controller="code-mirror-editor">
<?php

declare(strict_types=1);

use Flow\ETL\Flow;

use function Flow\ETL\Adapter\CSV\from_csv;
use function Flow\ETL\DSL\{data_frame, to_output};

require_once 'vendor/autoload.php';

$flow = new Flow();

data_frame()
    ->read(from_csv(__DIR__ . '/data/orders.csv'))
    ->limit(10)
    ->collect()
    ->write(to_output(truncate: false))
    ->run();
</textarea>
        </div>
    </div>
    <div class="output-container" data-playground-editor-target="outputContainer">
        <h2>Output</h2>
        <pre id="output" data-playground-editor-target="output"></pre>
    </div>
    <div class="file-preview-container" data-playground-editor-target="filePreviewContainer" style="display: none;">
        <div class="file-preview-header">
            <h2 data-playground-editor-target="filePreviewTitle">File Preview</h2>
            <div class="file-preview-actions">
                <button data-action="click->playground-editor#downloadPreviewFile" class="preview-action-btn" aria-label="Download file">
                    <img src="{{ asset('images/icons/upload.svg') }}" alt="Download" width="16" height="16" style="transform: rotate(180deg);">
                </button>
                <button data-action="click->playground-editor#closeFilePreview" class="preview-close-btn" aria-label="Close preview">×</button>
            </div>
        </div>
        <pre class="file-preview-content"><code data-playground-editor-target="filePreviewContent"></code></pre>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Cloudflare Turnstile Script -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endblock %}