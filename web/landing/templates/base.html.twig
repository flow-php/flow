                    defaults: '2026-01-30',
                    cookieless_mode: 'always'
                })
            </script>
        {% endif %}
    {% endblock %}

    {% block javascripts %}
        <script>
            window.flow = {
                dsl: {{ dsl() | raw }},
            };

            (function () {
                function resolvedTheme() {
                    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                }

                function pushGiscusTheme(theme) {
                    document.querySelectorAll('iframe.giscus-frame').forEach(function (iframe) {
                        iframe.contentWindow.postMessage(
                            { giscus: { setConfig: { theme: theme } } },
                            'https://giscus.app'
                        );
                    });
                }

                window.addEventListener('message', function (event) {
                    if (event.origin !== 'https://giscus.app') return;
                    if (!event.data || !event.data.giscus) return;
                    pushGiscusTheme(resolvedTheme());
                });

                document.addEventListener('theme:changed', function (event) {
                    pushGiscusTheme((event.detail && event.detail.resolved) || resolvedTheme());
                });
            })();
        </script>
        {{ importmap() }}
    {% endblock %}
</head>
<body class="scroll-smooth bg-[#e8eef7] text-slate-900 dark:bg-black dark:text-white" data-environment="{{ app.environment }}">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-orange-100 focus:px-3 focus:py-2 focus:text-white">
        Skip to content
    </a>

    {% block header %}
        {% include 'partials/header.html.twig' with {wide: false} %}
    {% endblock %}

    <main id="main">
        {% block hero %}
            {{ render(controller('Flow\\Website\\Controller\\LayoutController::hero')) }}
        {% endblock %}

        {% block main %}{% endblock %}

        {% block contributors %}
            {{ render(controller('Flow\\Website\\Controller\\LayoutController::contributors')) }}
        {% endblock %}
    </main>

    <a
        href="#main"
        class="fixed bottom-4 right-4 bg-orange-100 text-white p-2 rounded-full shadow-lg hover:bg-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100 focus:ring-opacity-50 sm:hidden opacity-0"
        data-controller="scroll-to-top" data-action="click->scroll-to-top#scrollToTop"
    >
        <img src="{{ asset('images/icons/arrow-up.svg') }}" width="32" height="32" alt="scroll back to top" class="inline">
    </a>

    {% block footer %}
        {% include 'partials/footer.html.twig' with {wide: false} %}
    {% endblock %}
</body>
</html>