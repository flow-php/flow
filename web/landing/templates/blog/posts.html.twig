{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - Blog
{%- endblock -%}

{%- block description -%}
    Blog posts and tutorials about Flow PHP, a PHP-based, strongly typed data processing framework with low memory footprint.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-10 lg:mt-14">
        <div class="max-w-2xl">
            <span class="eyebrow">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                Blog
            </span>
            <h1 class="mt-3 section-title">Notes from the project.</h1>
            <p class="mt-3 muted">
                Release notes, design decisions, and stories from building Flow.
            </p>
            <a class="mt-4 inline-flex items-center gap-1.5 text-sm text-blue-300 hover:text-orange-300 no-underline dark:text-blue-100 dark:hover:text-orange-100"
               href="{{ path('blog_rss') }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
                Subscribe via RSS
            </a>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {% for post in posts %}
                {% set postUrl = path('blog_post', {date: post.date | date('Y-m-d'), slug: post.slug}) %}
                <article class="card card-hover flex flex-col">
                    <div class="flex items-center justify-between gap-3">
                        <time datetime="{{ post.date | date('c') }}" class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-white/55">
                            {{ post.date | date('M j, Y') }}
                        </time>
                        <a class="no-underline" href="{{ post.authorUrl }}" target="_blank" rel="noopener" title="@{{ post.author }}">
                            <img class="h-6 w-6 rounded-full" src="{{ post.authorAvatarUrl(48) }}" alt="{{ post.author }}" loading="lazy"/>
                        </a>
                    </div>
                    <h2 class="mt-3 text-xl font-semibold tracking-tight">
                        <a class="text-slate-900 hover:text-orange-300 no-underline dark:text-white dark:hover:text-orange-100" href="{{ postUrl }}">
                            {{ post.title }}
                        </a>
                    </h2>
                    <p class="mt-2 muted text-sm leading-relaxed flex-1">
                        {{ post.description }}
                    </p>
                    <a class="mt-4 inline-flex items-center gap-1 text-sm text-blue-300 hover:text-orange-300 no-underline self-start dark:text-blue-100 dark:hover:text-orange-100"
                       href="{{ postUrl }}">
                        Read more <span aria-hidden="true">→</span>
                    </a>
                </article>
            {% endfor %}
        </div>
    </section>
{% endblock %}
