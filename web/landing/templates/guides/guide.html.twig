{% extends 'base.html.twig' %}

{%- block title -%}
    {{ guide.title }} | Flow PHP
{%- endblock -%}

{%- block description -%}
    {{ guide.description }}
{%- endblock -%}

{%- block og_type -%}article{%- endblock -%}

{% block social_image %}
    <meta property="og:image" content="{{ absolute_url(social_image) }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ guide.title }}" />
    <meta name="twitter:image" content="{{ absolute_url(social_image) }}">
{% endblock %}

{%- block hero -%}{%- endblock -%}

{%- block contributors -%}{%- endblock -%}

{% block main %}
    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-8 mb-16">
        <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-white/55">
            <ol class="inline-flex items-center gap-2">
                <li><a class="text-slate-700 hover:text-slate-900 no-underline dark:text-white/75 dark:hover:text-white" href="{{ path('guides') }}">Guides</a></li>
                <li aria-hidden="true">/</li>
                <li class="text-slate-800 dark:text-white/85">{{ guide.title }}</li>
            </ol>
        </nav>

        <p class="mt-2 mb-6 text-sm text-slate-500 dark:text-white/55" data-pagefind-ignore>
            Last updated <time datetime="{{ guide.updated }}">{{ guide.updated|date('M j, Y') }}</time>
        </p>

        <article id="documentation-page" class="min-w-0" data-pagefind-body>
            <span data-pagefind-filter="type:Guide" class="hidden" aria-hidden="true"></span>

            {{ guide.content|markdown_to_html }}
        </article>

        <aside class="mt-16" data-pagefind-ignore data-guide-related>
            <div class="flex items-center gap-4">
                <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-white/55">More guides</h2>
                <span class="h-px flex-1 bg-slate-200 dark:bg-white/10"></span>
            </div>
            <div class="mt-5 grid gap-5 md:grid-cols-3">
                {% for other in related %}
                    <article class="card card-hover flex flex-col">
                        <p class="font-mono text-xs text-orange-300 dark:text-orange-100">{{ other.card.problem }}</p>
                        <h3 class="mt-3 text-lg font-semibold tracking-tight">
                            <a class="text-slate-900 hover:text-orange-300 no-underline dark:text-white dark:hover:text-orange-100" href="{{ path('guides_guide', {slug: other.path}) }}">
                                {{ other.title }}
                            </a>
                        </h3>
                    </article>
                {% endfor %}
            </div>
        </aside>

        <p class="mt-12 text-sm text-slate-500 dark:text-white/55" data-pagefind-ignore>
            Found a typo or an outdated section?
            <a class="text-slate-700 hover:text-slate-900 no-underline dark:text-white/80 dark:hover:text-white"
               href="https://github.com/flow-php/flow/edit/1.x/web/landing/content/guides/{{ slug }}.md" target="_blank" rel="noopener">
                Edit this guide on GitHub
            </a>
        </p>
    </section>

    <script type="application/ld+json">{{ [
        {
            '@context': 'https://schema.org',
            '@type': 'Article',
            headline: guide.title,
            description: guide.description,
            datePublished: guide.published,
            dateModified: guide.updated,
            mainEntityOfPage: url('guides_guide', {slug: slug}),
        },
        {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
                {'@type': 'ListItem', position: 1, name: 'Guides', item: url('guides')},
                {'@type': 'ListItem', position: 2, name: guide.title, item: url('guides_guide', {slug: slug})},
            ],
        },
    ]|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endblock %}
