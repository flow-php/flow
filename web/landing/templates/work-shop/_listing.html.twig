{% extends 'base.html.twig' %}

{#
    Base listing template. Each product page extends this and provides metadata via
    `{% set %}` plus the `listing_body` block:
      listing_name      (string)  - product title
      listing_price     (string)  - formatted price, e.g. "$19.99"; omit to hide the price
      listing_tagline   (string)  - short one-line summary under the title
      listing_eyebrow   (string)  - small label above the title (default "Shop")
      listing_available (bool)     - false renders a disabled "Coming soon" button
      listing_cta_label (string)  - CTA button text (default "Buy now")
      listing_cta_url   (string)  - CTA target (default "#", checkout is out of scope)
      listing_checkout_url (string) - Polar checkout link; when set the CTA opens the
                                      embedded checkout and falls back to this URL without JS
      listing_image_aspect (string) - aspect-ratio for the image/carousel frame (default "16 / 9").
                                      Inline style rather than a Tailwind class because the value is
                                      per-listing and Tailwind only emits classes it finds literally.
#}

{%- block title -%}{{ listing_name|default('Shop') }} - Flow PHP - Data Processing Framework{%- endblock -%}

{%- block description -%}{{ listing_tagline|default('The Flow PHP Work-Shop. Blueprints and consulting for teams building with Flow.') }}{%- endblock -%}

{% block social_image %}
    {% if social_image is defined %}
        <meta property="og:image" content="{{ absolute_url(social_image) }}" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="{{ listing_name }}" />
        <meta name="twitter:image" content="{{ absolute_url(social_image) }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{%- block hero -%}{%- endblock -%}

{# The Work-Shop is a commercial offer by the maintainer, not a community effort. #}
{%- block contributors -%}{%- endblock -%}

{% block main %}
    {# `??` (not the `default` filter) so an explicit `false` is respected - `false|default(true)` returns true #}
    {% set listing_available = listing_available ?? true %}
    {% set listing_cta_url = listing_cta_url ?? '#' %}
    {% set listing_cta_label = listing_cta_label ?? 'Buy now' %}
    {% set listing_checkout_url = listing_checkout_url ?? null %}
    {% set listing_image = listing_image ?? null %}
    {% set listing_images = listing_images ?? [] %}
    {% set listing_image_aspect = listing_image_aspect ?? '16 / 9' %}
    <section class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 mt-12 lg:mt-16">
        <a href="{{ path('work_shop') }}"
           class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-white/70 dark:hover:text-white no-underline">
            <span aria-hidden="true">←</span> Back to the Work-Shop
        </a>

        <div class="mt-6 grid gap-8 lg:grid-cols-3 lg:gap-12">
            <div class="lg:col-span-2">
                {% if listing_images|length %}
                    <div {{ stimulus_controller('work_shop_carousel') }}
                         tabindex="0" role="group" aria-roledescription="carousel"
                         aria-label="{{ listing_name }} screenshots"
                         data-action="keydown->work-shop-carousel#keydown"
                         class="relative mb-8 overflow-hidden rounded-xl border border-slate-200 outline-none focus-visible:ring-2 focus-visible:ring-blue-300 dark:border-white/10 dark:focus-visible:ring-blue-100">
                        <div data-work-shop-carousel-target="track" class="flex transition-transform duration-300 ease-out">
                            {% for image in listing_images %}
                                <div data-work-shop-carousel-target="slide" class="w-full shrink-0" {{ loop.first ? '' : 'aria-hidden="true"' }}>
                                    <img src="{{ image }}" alt="{{ listing_name }} screenshot {{ loop.index }}" loading="lazy"
                                         style="aspect-ratio: {{ listing_image_aspect }}"
                                         class="w-full object-cover">
                                </div>
                            {% endfor %}
                        </div>

                        {% if listing_images|length > 1 %}
                            <button type="button" data-action="work-shop-carousel#prev" aria-label="Previous image"
                                    class="absolute left-3 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 backdrop-blur-sm transition-colors hover:bg-black/65">
                                <img src="{{ asset('images/icons/arrow-left.svg') }}" alt="" width="18" height="18">
                            </button>
                            <button type="button" data-action="work-shop-carousel#next" aria-label="Next image"
                                    class="absolute right-3 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 backdrop-blur-sm transition-colors hover:bg-black/65">
                                <img src="{{ asset('images/icons/arrow-right.svg') }}" alt="" width="18" height="18">
                            </button>
                            <div class="absolute inset-x-0 bottom-3 flex justify-center gap-2">
                                {% for image in listing_images %}
                                    <button type="button" data-work-shop-carousel-target="dot"
                                            data-action="work-shop-carousel#goTo" data-work-shop-carousel-index-param="{{ loop.index0 }}"
                                            aria-label="Go to image {{ loop.index }}"
                                            class="h-2 w-2 rounded-full transition-colors {{ loop.first ? 'bg-white' : 'bg-white/40' }}"></button>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% elseif listing_image %}
                    <img src="{{ listing_image }}" alt="{{ listing_name }}"
                         style="aspect-ratio: {{ listing_image_aspect }}"
                         class="mb-8 w-full rounded-xl border border-slate-200 object-cover dark:border-white/10">
                {% endif %}

                <span class="eyebrow">
                    <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
                    {{ listing_eyebrow|default('Shop') }}
                </span>
                <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">{{ listing_name }}</h1>
                {% if listing_tagline|default(false) %}
                    <p class="mt-5 muted text-lg leading-relaxed">{{ listing_tagline }}</p>
                {% endif %}

                <div class="mt-8 text-slate-700 dark:text-white/85 leading-relaxed">
                    {% block listing_body %}{% endblock %}
                </div>
            </div>

            <aside class="lg:col-span-1">
                <div class="card lg:sticky lg:top-24">
                    <div class="flex items-baseline justify-between gap-3">
                        {% if listing_price|default(false) %}
                            <span class="flex items-baseline gap-2">
                                <span class="text-3xl font-bold tracking-tight">{{ listing_price }}</span>
                                {% if listing_price_cadence|default(false) %}
                                    <span class="muted text-xs">{{ listing_price_cadence }}</span>
                                {% endif %}
                                <span class="muted text-xs">excl. tax</span>
                            </span>
                        {% endif %}
                        {% if not listing_available %}
                            <span class="inline-flex items-center rounded-full bg-slate-500/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-500 ring-1 ring-slate-400/30 dark:text-white/55 dark:ring-white/15">
                                Coming soon
                            </span>
                        {% endif %}
                    </div>

                    {% if listing_available %}
                        <a href="{{ listing_checkout_url ?? listing_cta_url }}"
                           {% if listing_checkout_url %}{{ stimulus_controller('work_shop_checkout', { url: listing_checkout_url }) }} data-action="work-shop-checkout#open"{% endif %}
                           class="btn btn-primary mt-6 w-full px-4 py-2.5">
                            {% if listing_price|default(false) %}
                                <img src="{{ asset('images/icons/cart.svg') }}" alt="" width="16" height="16">
                            {% endif %}
                            {{ listing_cta_label }}
                        </a>
                    {% else %}
                        <button type="button" disabled aria-disabled="true"
                                class="btn btn-secondary mt-6 w-full px-4 py-2.5 cursor-not-allowed opacity-60">
                            Coming soon
                        </button>
                    {% endif %}

                    {% block listing_aside %}{% endblock %}

                    {# Only where something is actually sold - consultations are not governed by the Terms of Sale. #}
                    {% if listing_checkout_url %}
                        <p class="mt-5 border-t border-slate-200 pt-4 text-xs muted leading-relaxed dark:border-white/10">
                            By buying you accept our
                            <a href="{{ path('work_shop_terms_of_sales') }}" class="underline underline-offset-2 hover:text-slate-900 dark:hover:text-white">Terms of Sale</a>
                            and
                            <a href="{{ path('work_shop_privacy_policy') }}" class="underline underline-offset-2 hover:text-slate-900 dark:hover:text-white">Privacy Policy</a>.
                        </p>
                    {% endif %}
                </div>
            </aside>
        </div>
    </section>
{% endblock %}
