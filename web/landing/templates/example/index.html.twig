{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - {{ currentTopic|humanize }} - {{ currentExample|humanize }} - Example
{%- endblock -%}

{%- block description -%}
    Code example showing {{ currentExample|humanize|lower }} {{ currentTopic|humanize|lower }}.
{%- endblock -%}

{% block main %}
    <div class="py-10 px-2 sm:px-4 mx-auto max-w-screen-2xl">
        <h2 class="mb-4 text-2xl font-semibold tracking-wide">Examples:</h2>
        <nav class="font-medium text-center bg-orange-100 rounded">
            <ul class="flex whitespace-nowrap overflow-auto justify-between">
                {% for topic, route in topicsNavigation %}
                    <li class="grow">
                        <a href="{{ path(route.name, route.arguments) }}#example" class="{% if currentTopic == topic %}active {% elseif currentTopic is null and loop.first %}active {% endif %}inline-block leading-10 px-4 py-2 w-full [&.active]:bg-orange-300 rounded">
                            {{ topic|humanize }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <div class="-mt-20 pt-20">
            <nav>
                <ul class="flex whitespace-nowrap overflow-auto py-2">
                    {% for example, route in examplesNavigation %}
                        <li>
                            <a href="{{ path(route.name, route.arguments) }}#example" class="{% if currentExample == example %}active {% elseif currentExample is null and loop.first %}active {% endif %}w-max tracking-wide flex items-center leading-8 px-2 [&.active]:bg-orange-300 rounded">
                                <img src="{{ asset('images/icons/flow.svg') }}" alt="flow php icon" width="16" height="16" class="mr-2">
                                {{ example|humanize }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {% if optionsNavigation|length > 0 %}
            <nav class="bg-gray-50 rounded px-3 pb-2 mb-4">
                <ul class="flex whitespace-nowrap overflow-auto gap-1">
                    {% for option, route in optionsNavigation %}
                        <li>
                            <a href="{{ path(route.name, route.arguments) }}#example"
                               class="{% if currentOption == option %}active {% elseif currentOption is null and loop.first %}active {% endif %}inline-block text-sm px-3 py-1 rounded hover:bg-orange-200 transition-colors [&.active]:bg-orange-300 [&.active]:font-medium [&.active]:rounded">
                                {{ option|humanize }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
            {% endif %}

            <div id="example" class="-mt-36 pt-36">
                {% if description %}
                    <h2 class="text-xl mt-5">Description</h2>
                    <article id="example-description"
                             class="rounded px-4 pt-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 relative mb-5"
                            {{ stimulus_controller('all_links_external') }}
                    >
                        {{ description|markdown_to_html }}
                    </article>
                {% endif %}

                {% if documentation %}
                    <h2 class="text-xl mt-5">Documentation</h2>
                    <article class="rounded px-4 pt-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 relative mb-5">
                        {{ documentation|markdown_to_html }}
                    </article>
                {% endif %}

                {% apply spaceless %}
                <h2 class="text-xl mt-5 mb-5" id="documentation">Code</h2>
                <div id="code" class="relative">
                    <div class="absolute top-[12px] right-[12px] flex gap-2">
                        <a href="{{ path(playgroundUrl.name, playgroundUrl.arguments) }}"
                           class="bg-orange-100 rounded px-4 leading-9 hover:bg-orange-200"
                           title="Try in Playground">
                            <img src="{{ asset('images/icons/play.svg') }}" alt="play" width="20" height="20" class="inline">
                        </a>
                        <button class="bg-orange-100 rounded px-4 leading-9 [&.copied]:before:content-['Copied!'] before:absolute before:-translate-x-20"
                                data-clipboard-target="#code-php"
                                {{ stimulus_controller('clipboard') }}>
                            <img src="{{ asset('images/icons/copy.svg') }}" alt="copy code-php" width="20" height="20" class="inline">
                        </button>
                    </div>
                    <pre class="rounded p-4 overflow-auto shadow-2xl shadow-gray rounded border-gray border-2 language-php" data-controller="syntax-highlight" >
                        <code id="code-php">
                            {{- code | escape('html') -}}
                        </code>
                    </pre>
                </div>
                {% endapply %}
            </div>

            <div class="mt-5">
                <script src="https://giscus.app/client.js"
                        data-repo="flow-php/flow-php.com"
                        data-repo-id="R_kgDOHja2Yg"
                        data-category="Examples"
                        data-category-id="DIC_kwDOHja2Ys4CieC7"
                        data-mapping="url"
                        data-strict="0"
                        data-reactions-enabled="0"
                        data-emit-metadata="0"
                        data-input-position="bottom"
                        data-theme="dark"
                        data-lang="en"
                        crossorigin="anonymous"
                        async>
                </script>
            </div>
        </div>
    </div>
{% endblock %}
