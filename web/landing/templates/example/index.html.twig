{% extends 'base.html.twig' %}

{%- block title -%}
    Flow PHP - {{ currentTopic|humanize }} - {{ currentExample|humanize }} - Example
{%- endblock -%}

{%- block description -%}
    Code example showing {{ currentExample|humanize|lower }} {{ currentTopic|humanize|lower }}.
{%- endblock -%}

{%- block hero -%}{%- endblock -%}

{% block main %}
    <div class="pt-10 pb-5 px-4 sm:px-6 lg:px-8 mx-auto max-w-screen-2xl">
        <span class="eyebrow">
            <span class="h-1.5 w-1.5 rounded-full bg-orange-100"></span>
            Examples
        </span>
        <h1 class="mt-3 section-title mb-5">{{ currentTopic|humanize }}</h1>

        {% include 'partials/topic_nav.html.twig' with {topicsNavigation: topicsNavigation, currentTopic: currentTopic} %}

        <div class="-mt-20 pt-20">
            <nav aria-label="Example" class="mt-3 rounded-xl border border-slate-200 bg-white p-1.5 dark:border-white/10 dark:bg-white/[0.03]">
                <ul class="flex whitespace-nowrap overflow-x-auto gap-1 scrollbar-hide">
                    {% for example, route in examplesNavigation %}
                        {% set isActive = (currentExample == example) or (currentExample is null and loop.first) %}
                        <li>
                            <a href="{{ path(route.name, route.arguments) }}#example"
                               class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium no-underline transition-colors
                                      {{ isActive ? 'bg-orange-100 text-white hover:bg-orange-200' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-white/75 dark:hover:text-white dark:hover:bg-white/[0.06]' }}"
                               {% if isActive %}aria-current="page"{% endif %}>
                                <img src="{{ asset('images/icons/flow.svg') }}" alt="" width="14" height="14" class="opacity-80 {{ isActive ? '' : 'dark:invert-0 invert' }}">
                                {{ example|humanize }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {% if optionsNavigation|length > 0 %}
            <nav aria-label="Option" class="mt-3 relative"
                 data-controller="horizontal-scroll">
                <div class="rounded-xl border border-slate-200 bg-white p-1.5 dark:border-white/10 dark:bg-white/[0.03]">
                    <ul class="flex whitespace-nowrap overflow-auto gap-1 scroll-smooth"
                        data-horizontal-scroll-target="container">
                        {% for option, route in optionsNavigation %}
                            {% set isActive = (currentOption == option) or (currentOption is null and loop.first) %}
                            <li>
                                <a href="{{ path(route.name, route.arguments) }}#example"
                                   class="inline-block text-sm px-3 py-1.5 rounded-lg no-underline transition-colors
                                          {{ isActive ? 'bg-orange-100 text-white font-medium hover:bg-orange-200' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-white/75 dark:hover:text-white dark:hover:bg-white/[0.06]' }}"
                                   {% if isActive %}aria-current="page"{% endif %}>
                                    {{ option|humanize }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <button type="button"
                        class="absolute left-1 top-1/2 -translate-y-1/2 z-10 h-8 w-8 inline-flex items-center justify-center bg-white hover:bg-slate-50 border border-slate-300 rounded-full transition-opacity duration-200 opacity-0 pointer-events-none dark:bg-black/80 dark:hover:bg-black dark:border-white/10"
                        aria-label="Scroll left"
                        data-horizontal-scroll-target="leftArrow"
                        data-action="click->horizontal-scroll#scrollLeft">
                    <img src="{{ asset('images/icons/arrow-left.svg') }}" alt="" width="14" height="14" class="dark:invert-0 invert">
                </button>
                <button type="button"
                        class="absolute right-1 top-1/2 -translate-y-1/2 z-10 h-8 w-8 inline-flex items-center justify-center bg-white hover:bg-slate-50 border border-slate-300 rounded-full transition-opacity duration-200 opacity-0 pointer-events-none dark:bg-black/80 dark:hover:bg-black dark:border-white/10"
                        aria-label="Scroll right"
                        data-horizontal-scroll-target="rightArrow"
                        data-action="click->horizontal-scroll#scrollRight">
                    <img src="{{ asset('images/icons/arrow-right.svg') }}" alt="" width="14" height="14" class="dark:invert-0 invert">
                </button>
            </nav>
            {% endif %}

            <div id="example" class="-mt-36 pt-36">
                {% if description %}
                    <h2 class="text-xl font-semibold mt-8 mb-3">Description</h2>
                    <article id="example-description"
                             class="card overflow-auto"
                            {{ stimulus_controller('all_links_external') }}
                    >
                        {{ description|markdown_to_html }}
                    </article>
                {% endif %}

                {% if documentation %}
                    <h2 class="text-xl font-semibold mt-8 mb-3">Documentation</h2>
                    <article class="card overflow-auto">
                        {{ documentation|markdown_to_html }}
                    </article>
                {% endif %}

                {% apply spaceless %}
                <h2 class="text-xl font-semibold mt-8 mb-3" id="documentation">Code</h2>
                <div id="code" class="relative">
                    <div class="absolute top-3 right-3 flex gap-2 z-10">
                        <a href="{{ path(playgroundUrl.name, playgroundUrl.arguments) }}"
                           class="inline-flex items-center justify-center h-9 w-9 rounded-md bg-orange-100 hover:bg-orange-200 text-white no-underline"
                           title="Try in Playground"
                           aria-label="Try in Playground">
                            <img src="{{ asset('images/icons/play.svg') }}" alt="" width="18" height="18">
                        </a>
                        <button class="inline-flex items-center justify-center h-9 w-9 rounded-md bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 [&.copied]:before:content-['Copied!'] before:absolute before:-translate-x-20 dark:bg-white/[0.06] dark:hover:bg-white/[0.12] dark:border-white/10 dark:text-white"
                                data-clipboard-target="#code-php"
                                aria-label="Copy code"
                                {{ stimulus_controller('clipboard') }}>
                            <img src="{{ asset('images/icons/copy.svg') }}" alt="" width="18" height="18" class="dark:invert-0 invert">
                        </button>
                    </div>
                    <pre class="card !p-4 overflow-auto language-php" data-controller="syntax-highlight">
                        <code id="code-php">
                            {{- code | escape('html') -}}
                        </code>
                    </pre>
                </div>
                {% endapply %}
            </div>

            <div class="mt-5">
                <script src="https://giscus.app/client.js"
                        data-repo="flow-php/flow-php.com"
                        data-repo-id="R_kgDOHja2Yg"
                        data-category="Examples"
                        data-category-id="DIC_kwDOHja2Ys4CieC7"
                        data-mapping="url"
                        data-strict="0"
                        data-reactions-enabled="0"
                        data-emit-metadata="0"
                        data-input-position="bottom"
                        data-theme="preferred_color_scheme"
                        data-lang="en"
                        crossorigin="anonymous"
                        async>
                </script>
            </div>
        </div>
    </div>
{% endblock %}
