/**
 * ACE Editor Completer for Flow PHP DataFrame Methods
 *
 * Auto-generated on {{ generated_at|date('Y-m-d H:i:s') }}
 * DataFrame methods: {{ total_count }}
 * DataFrame-returning methods: {% for class, methods in dataframe_returning_methods %}{{ class }}({{ methods|length }}){% if not loop.last %}, {% endif %}{% endfor %}
 *
 * This completer triggers after DataFrame-returning methods: extract()->, read()->, filter()->
 */

ace.define("ace/completers/data_frame", ["require", "exports", "module"], function(require, exports, module) {
    "use strict";

    var snippetManager = require("ace/snippets").snippetManager;

    // Map of methods that return DataFrame, grouped by class
    var dataFrameReturningMethods = {
        {% for class, methods in dataframe_returning_methods %}
        "{{ class }}": [{% for method in methods %}"{{ method }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% if not loop.last %},{% endif %}

        {% endfor %}
    };

    // DataFrame-specific methods
    var dataFrameMethods = [
        {% for method in dataframe_methods %}
        {
            name: "{{ method.name }}",
            caption: "{{ method.name }}",
            snippet: "{{ method.snippet|replace({'"': '\\"', "'": "\\'", '\\': '\\\\'})|raw }}",
            meta: "dataframe",
            score: 900000,
            docHTML: "<pre><code>{{ method.highlightedSignature|replace({'"': '\\"', "'": "\\'"})|raw }}</code></pre>{% if method.docComment %}<p>{{ method.docComment|replace({'"': '\\"', "'": "\\'"})|raw }}</p>{% endif %}"
        }{% if not loop.last %},{% endif %}

        {% endfor %}
    ];

    var dataFrameCompleter = {
        identifierRegexps: [/[a-zA-Z_0-9\$\->\u00A2-\uFFFF]/],

        getCompletions: function(editor, session, pos, prefix, callback) {
            if (session.$mode && session.$mode.$id !== 'ace/mode/php') {
                callback(null, []);
                return;
            }

            // Don't show completions inside strings
            var token = session.getTokenAt(pos.row, pos.column);
            if (token && (token.type === 'string' || token.type.indexOf('string') !== -1)) {
                callback(null, []);
                return;
            }

            var line = session.getLine(pos.row);
            var beforeCursor = line.slice(0, pos.column - prefix.length);

            // Check if we're after -> operator
            if (!/->\\s*$/.test(beforeCursor)) {
                callback(null, []);
                return;
            }

            var isDataFrameContext = false;

            // Check if any DataFrame-returning method was called before ->
            // This works for: df()->read()-> or $df->filter()->
            for (var classSlug in dataFrameReturningMethods) {
                var methods = dataFrameReturningMethods[classSlug];
                var methodPattern = new RegExp('(' + methods.join('|') + ')\\s*\\([^\\)]*\\)\\s*->\\s*$');
                if (methodPattern.test(beforeCursor)) {
                    isDataFrameContext = true;
                    break;
                }
            }

            if (!isDataFrameContext) {
                callback(null, []);
                return;
            }

            // Show only DataFrame methods
            var completions = dataFrameMethods.filter(function(item) {
                return !prefix || item.name.toLowerCase().indexOf(prefix.toLowerCase()) === 0;
            }).map(function(item) {
                var itemCopy = Object.assign({}, item);
                if (item.name.toLowerCase().indexOf(prefix.toLowerCase()) === 0) {
                    itemCopy.score = 900000 + (10000 - prefix.length);
                }
                return itemCopy;
            });

            callback(null, completions);
        },

        getDocTooltip: function(item) {
            if (item.docHTML) {
                return { docHTML: item.docHTML };
            }
        },

        insertMatch: function(editor, data) {
            if (data.snippet) {
                snippetManager.insertSnippet(editor, data.snippet);
            } else {
                editor.completer.insertMatch(data);
            }
        }
    };

    module.exports = dataFrameCompleter;
});
