# Turnstile Secret Key (not needed for bypass/mock/mock-fail modes)
# Get from: cd .. && terraform output -raw turnstile_secret_key
TURNSTILE_SECRET_KEY=dummy

# Turnstile verification mode:
# - bypass: Skip verification entirely (no token required, fastest for development)
# - mock: Accept any token without API call (test full widget flow without real verification)
# - mock-fail: Reject any token (test error handling and failure scenarios)
# - verify: Full production verification with Cloudflare API (default if not set)
TURNSTILE_MODE=bypass
