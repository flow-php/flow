{
    "name": "flow-php/symfony-postgresql-cache-bridge",
    "type": "library",
    "description": "PHP ETL - Symfony PostgreSQL Cache bridge",
    "keywords": [
        "symfony",
        "postgresql",
        "cache",
        "bridge"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "flow-php/postgresql": "self.version",
        "symfony/cache": "^6.4 || ^7.4 || ^8.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Flow\\": [
                "src/Flow"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\": "tests/Flow"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
