{
    "name": "flow-php/snappy",
    "type": "library",
    "description": "Pure PHP implementation of the Google Snappy compression algorithm.",
    "keywords": [
        "etl",
        "extract",
        "transform",
        "load",
        "filter",
        "snappy",
        "algorithm",
        "compression"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Flow\\": [
                "src/Flow"
            ]
        },
        "files": [
            "polyfill.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\": "tests/Flow"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
