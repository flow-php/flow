{
    "name": "flow-php/parquet-viewer",
    "type": "library",
    "description": "PHP ETL - cli application for viewing parquet files",
    "keywords": [
        "etl",
        "extract",
        "transform",
        "load",
        "filter",
        "parquet"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "coduo/php-humanizer": "^5.0",
        "flow-php/etl": "self.version",
        "flow-php/parquet": "self.version",
        "symfony/console": "^6.4 || ^7.3 || ^8.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "suggest": {
        "ext-arrow": "For high-performance Parquet reading/writing via Apache Arrow"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Flow\\": [
                "src/Flow"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\": "tests/Flow"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
