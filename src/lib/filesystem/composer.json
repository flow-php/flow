{
    "name": "flow-php/filesystem",
    "type": "library",
    "description": "One filesystem API for local disks, S3, Azure Blob Storage and SFTP.",
    "keywords": [
        "etl",
        "extract",
        "transform",
        "load",
        "filesystem",
        "remote",
        "azure",
        "aws"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "flow-php/telemetry": "self.version",
        "flow-php/types": "self.version",
        "symfony/polyfill-mbstring": "^1.33"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Flow\\": [
                "src/Flow"
            ]
        },
        "files": [
            "src/Flow/Filesystem/DSL/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\": "tests/Flow"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
