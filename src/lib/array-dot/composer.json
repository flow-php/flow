{
    "name": "flow-php/array-dot",
    "type": "library",
    "description": "Read and change nested PHP arrays with dot notation.",
    "keywords": [
        "etl",
        "extract",
        "transform",
        "load",
        "filter",
        "array",
        "dot"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "flow-php/types": "self.version"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Flow\\": [
                "src/Flow"
            ]
        },
        "files": [
            "src/Flow/ArrayDot/array_dot.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\": "tests/Flow"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
