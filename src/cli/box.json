{
  "alias": "flow.phar",
  "banner": false,
  "blacklist": [
    ".github",
    "examples",
    "docs",
    "tests",
    "tools",
    "var",
    "fakerphp",
    "mock-client",
    "dotenv",
    "var-exporter",
    "resources/python",
    "bin/parquet.php",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "check-requirements": false,
  "compression": "GZ",
  "directories": [
    "src",
    "vendor"
  ],
  "exclude-dev-files": false,
  "git-version": "git_version",
  "output": "./../../build/flow.phar"
}
