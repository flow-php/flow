--TEST--
The reader's canonical schema hint reads a file whose ARROW:schema carries dictionary, string-view and binary-view string encodings and a uuid column as the PHP engine does
--SKIPIF--
<?php if (!extension_loaded("arrow")) die("skip arrow extension not loaded"); ?>
--FILE--
<?php
require __DIR__ . '/bootstrap.php';

use Flow\Parquet\Engine\PhpParquetEngine;
use Flow\Parquet\Engine\RustParquetEngine;
use Flow\Parquet\Reader;
use Flow\Parquet\Tests\Context\ParquetRows;

// generated by fixtures/arrow_schema_hints.py (pyarrow): dict Dictionary(Int32, Utf8), view Utf8View,
// binary_view BinaryView, plain Utf8, binary Binary, uuid arrow.uuid over FixedSizeBinary(16), id Int64
$fixture = __DIR__ . '/fixtures/arrow_schema_hints.parquet';
$hex = static fn(array $rows): array => array_map(
    static fn(array $row): array => array_map(static fn(mixed $value): mixed => is_string($value) ? bin2hex($value) : $value, $row),
    $rows,
);

$php = $hex(ParquetRows::read((new Reader(engine: new PhpParquetEngine()))->read($fixture), 10));
$arrow = $hex(ParquetRows::read((new Reader(engine: new RustParquetEngine()))->read($fixture), 10));

echo json_encode($arrow), "\n";
echo $php === $arrow ? "identical\n" : 'php: ' . json_encode($php) . "\n";
--EXPECT--
[{"dict":"61","view":"6f6e65","binary_view":"0001","plain":"70","binary":"02","uuid":"30303031303230332d303430352d303630372d303830392d306130623063306430653066","id":0},{"dict":"62","view":null,"binary_view":null,"plain":"71","binary":null,"uuid":null,"id":1},{"dict":null,"view":"","binary_view":"","plain":null,"binary":"","uuid":"61626162616261622d616261622d616261622d616261622d616261626162616261626162","id":2},{"dict":"61","view":"666f7572","binary_view":"ff","plain":"","binary":"fe","uuid":"31303131313231332d313431352d313631372d313831392d316131623163316431653166","id":3},{"dict":"63","view":"66697665","binary_view":"78797a","plain":"72","binary":"62696e","uuid":"30303030303030302d303030302d303030302d303030302d303030303030303030303030","id":4}]
identical
